---
const groups = [
  {
    title: 'Segurança patrimonial',
    description: 'Três caminhos visuais para apresentar a presença e o cuidado da equipe.',
    items: [
      { id: 'seguranca-branco', label: '01', style: 'Fundo branco', image: '/outubro/seguranca-branco-v2.webp', caption: 'Sempre vigilantes. Cuidado com as pessoas. Atenção ao patrimônio. A Multiforte atua para proteger o que importa na rotina de empresas e condomínios. Conheça nossas soluções de segurança. #Multiforte #SegurançaPatrimonial' },
      { id: 'seguranca-vermelho', label: '02', style: 'Vermelho em destaque', image: '/outubro/seguranca-vermelho-v2.webp', caption: 'Estar presente é cuidar de cada detalhe. A Multiforte une profissionais, atenção e responsabilidade para apoiar a segurança patrimonial da sua operação. Fale com nossa equipe e solicite uma proposta. #Multiforte #SegurançaPatrimonial' },
      { id: 'seguranca-foto', label: '03', style: 'Fotográfica escura', image: '/outubro/seguranca-foto-v2.webp', caption: 'Segurança é feita por pessoas preparadas e atentas à sua rotina. A Multiforte valoriza quem está presente em cada posto. Conheça nossas soluções. #Multiforte #SegurançaPatrimonial' },
    ],
  },
  {
    title: 'Facilities · limpeza',
    description: 'Três abordagens para mostrar o cuidado com ambientes e pessoas.',
    items: [
      { id: 'facilities-branco', label: '04', style: 'Fundo branco', image: '/outubro/facilities-branco-v2.webp', caption: 'Limpeza que valoriza sua empresa. O cuidado com os ambientes contribui para uma rotina mais acolhedora para equipes, clientes e visitantes. Conheça os serviços de facilities da Multiforte. #Multiforte #Facilities #LimpezaProfissional' },
      { id: 'facilities-vermelho', label: '05', style: 'Vermelho em destaque', image: '/outubro/facilities-vermelho-v2.webp', caption: 'Cuidado em cada espaço. A limpeza das áreas comuns faz parte da experiência de quem circula pelo seu condomínio. Converse com a Multiforte sobre a necessidade da sua operação. #Multiforte #Facilities #LimpezaProfissional' },
      { id: 'facilities-foto', label: '06', style: 'Fotográfica escura', image: '/outubro/facilities-foto-v2.webp', caption: 'Quem cuida faz a diferença. Por trás de cada ambiente bem cuidado, existe o trabalho de profissionais comprometidos com a rotina das pessoas. Solicite uma proposta de facilities. #Multiforte #Facilities #LimpezaProfissional' },
    ],
  },
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Avaliação das artes de outubro da Multiforte." />
    <title>Artes de outubro | Multiforte</title>
    <link rel="icon" href="/images/imgi_23_icon.webp" />
    <style>
      @font-face{font-family:Montserrat;src:url('/fonts/optimized/montserrat-800.c03300163e.woff2') format('woff2');font-weight:800;font-display:swap}
      @font-face{font-family:Inter;src:url('/fonts/optimized/inter-400.06c504d11b.woff2') format('woff2');font-weight:400;font-display:swap}
      :root{font-family:Inter,Arial,sans-serif;color:#25282b;background:#f4f4f3}*{box-sizing:border-box}body{margin:0}button,textarea{font:inherit}button{cursor:pointer}a{color:inherit}header{background:#181a1d;color:white;border-bottom:5px solid #d71920}header .inner{max-width:1220px;margin:auto;padding:21px 24px;display:flex;align-items:center;justify-content:space-between;gap:24px}header img{width:180px;height:auto;display:block}header span{font-size:.8rem;letter-spacing:.13em;text-transform:uppercase;color:#d7d7d7}.hero{max-width:1220px;margin:auto;padding:55px 24px 28px}.eyebrow{font-size:.75rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#c5161d}.hero h1{font:800 clamp(2.1rem,5vw,4.5rem)/1.02 Montserrat,Arial,sans-serif;text-transform:uppercase;letter-spacing:-.04em;max-width:850px;margin:13px 0 18px}.hero p{max-width:730px;line-height:1.65;color:#5a5d61;margin:0}.notice{margin-top:26px;background:white;border-left:4px solid #d71920;border-radius:8px;padding:17px 20px;max-width:850px;line-height:1.5}.notice strong{display:block;margin-bottom:3px}.system{max-width:1220px;margin:0 auto;padding:0 24px;min-height:27px;color:#555;font-size:.85rem}.system[data-kind=error]{color:#a21319;font-weight:700}.system[data-kind=success]{color:#286b46}.group{max-width:1220px;margin:0 auto;padding:26px 24px 56px}.grouphead{display:flex;align-items:end;justify-content:space-between;gap:24px;border-top:1px solid #d8dadd;padding-top:27px;margin-bottom:22px}.grouphead h2{font:800 clamp(1.4rem,3vw,2.25rem)/1.1 Montserrat,Arial,sans-serif;text-transform:uppercase;letter-spacing:-.03em;margin:0 0 8px}.grouphead p{margin:0;color:#666}.count{color:#b11920;font-weight:800;white-space:nowrap}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px}.card{background:white;border:1px solid #e2e2e2;border-radius:12px;overflow:hidden;box-shadow:0 10px 28px #1012190a}.imagewrap{background:#d8d8d8;position:relative}.imagewrap img{display:block;width:100%;height:auto;aspect-ratio:1122/1402;object-fit:cover}.expand{position:absolute;right:12px;bottom:12px;background:#fff;color:#191919;border:0;border-radius:6px;padding:9px 12px;font-weight:800;box-shadow:0 2px 10px #0004}.cardbody{padding:19px}.cardtop{display:flex;justify-content:space-between;align-items:center;gap:12px}.cardtop h3{font:800 1.07rem Montserrat,Arial,sans-serif;margin:0}.badge{background:#f2f2f2;color:#555;border-radius:4px;padding:7px 9px;font-size:.74rem;font-weight:800;white-space:nowrap}.badge[data-status=approved]{background:#e4f4ea;color:#22633f}.badge[data-status=changes]{background:#fff0e9;color:#a54517}.badge[data-status=draft]{background:#eaf0fc;color:#314e88}.download{font-size:.82rem;font-weight:800;color:#b1181f;display:inline-block;margin:15px 0 20px;text-decoration:none}.download:hover{text-decoration:underline}label{display:block;font-size:.8rem;font-weight:800;margin:0 0 8px}textarea{display:block;width:100%;resize:vertical;min-height:145px;border:1px solid #cfd1d3;border-radius:6px;background:#fff;padding:12px;line-height:1.5;font-size:.86rem;color:#25282b}textarea:focus{outline:2px solid #d71920;outline-offset:1px}.feedback{min-height:85px;margin-top:14px}.actions{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:15px}.actions button{border:0;border-radius:5px;padding:12px 9px;font-size:.8rem;font-weight:800;min-height:43px}.approve{background:#cf151d;color:white}.request{background:#22262a;color:#fff}.save{grid-column:span 2;background:#efefef;color:#333}.actions button:disabled{opacity:.45;cursor:not-allowed}.updated{min-height:17px;color:#656565;font-size:.73rem;margin:12px 0 0}.foot{background:#202226;color:#ddd;padding:30px 24px;text-align:center;font-size:.8rem;line-height:1.6}.foot strong{color:white}dialog{border:0;padding:0;background:transparent;max-width:min(90vw,720px);max-height:94vh;box-shadow:0 20px 80px #0008}dialog::backdrop{background:#000d}dialog img{display:block;max-width:100%;max-height:90vh}dialog button{position:absolute;right:9px;top:9px;border:0;background:white;padding:9px 12px;border-radius:4px;font-weight:800}@media(max-width:900px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){header .inner{padding:17px 18px}header img{width:145px}header span{font-size:.65rem;max-width:100px;text-align:right}.hero{padding:38px 18px 25px}.group{padding:23px 18px 38px}.grid{grid-template-columns:1fr}.grouphead{align-items:start}.count{display:none}.cardbody{padding:17px}.system{padding:0 18px}}
    </style>
  </head>
  <body>
    <header><div class="inner"><a href="/" aria-label="Multiforte, página inicial"><img src="/images/imgi_1_logo_multiforte_branca.webp" width="180" alt="Multiforte Segurança" /></a><span>Apresentação de criativos · Outubro 2026</span></div></header>
    <main>
      <section class="hero">
        <div class="eyebrow">Multiforte · Aprovação de conteúdo</div>
        <h1>Artes de outubro</h1>
        <p>Confira as propostas de segurança e facilities. Em cada arte, você pode ajustar a legenda, aprovar o conjunto ou descrever o que deve ser alterado. As respostas ficam registradas para acompanhamento.</p>
        <div class="notice"><strong>Primeiro lote · 6 propostas visuais</strong>Estas são variações para avaliação dentro do planejamento de 12 publicações. A aprovação de uma arte inclui a legenda exibida no momento do envio.</div>
      </section>
      <div class="system" id="system" role="status" aria-live="polite">Carregando avaliações…</div>
      {groups.map(group => <section class="group" aria-label={group.title}>
        <div class="grouphead"><div><h2>{group.title}</h2><p>{group.description}</p></div><div class="count">03 propostas</div></div>
        <div class="grid">{group.items.map(item => <article class="card" data-id={item.id} data-revision="2">
          <div class="imagewrap"><img src={item.image} width="1122" height="1402" loading="lazy" alt={`Proposta ${item.label}: ${group.title}, ${item.style}`} /><button class="expand" type="button" data-image={item.image} aria-label={`Ampliar proposta ${item.label}`}>Ampliar ↗</button></div>
          <div class="cardbody"><div class="cardtop"><h3>{item.label} · {item.style}</h3><span class="badge" data-status="pending">Pendente</span></div>
            <a class="download" href={item.image} download={`multiforte-${item.id}.webp`}>Baixar arte ↓</a>
            <label for={`caption-${item.id}`}>Legenda sugerida · você pode editar</label>
            <textarea id={`caption-${item.id}`} class="caption" maxlength="2000" data-original={item.caption}>{item.caption}</textarea>
            <label for={`feedback-${item.id}`} style="margin-top:15px">Alterações desejadas</label>
            <textarea id={`feedback-${item.id}`} class="feedback" maxlength="2000" placeholder="Descreva os ajustes da arte ou da legenda…"></textarea>
            <div class="actions"><button class="approve" type="button" data-action="approved" disabled>Aprovar arte e legenda</button><button class="request" type="button" data-action="changes" disabled>Solicitar ajustes</button><button class="save" type="button" data-action="draft" disabled>Salvar legenda e observações</button></div>
            <p class="updated" aria-live="polite"></p>
          </div>
        </article>)}</div>
      </section>)}
    </main>
    <footer class="foot"><strong>Multiforte Segurança</strong><br />Material para avaliação. Acesso pelo link compartilhado.</footer>
    <dialog id="preview"><button type="button" aria-label="Fechar imagem">Fechar ✕</button><img alt="Arte ampliada" /></dialog>
    <script src="/outubro/reviews.js" defer></script>
  </body>
</html>
