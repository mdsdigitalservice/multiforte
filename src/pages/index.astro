---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import { navigation } from '../data/site';
---
<BaseLayout title="Multiforte Segurança — Prévia de migração" noindex={true}>
  <Header links={navigation} />
  <main id="conteudo">
    <aside class="bg-brand px-6 py-3 text-center text-sm text-white">Prévia técnica. Conteúdo original e URLs aguardam importação e conferência.</aside>
    <Hero title="Multiforte Segurança" image="/images/imgi_67_quem-somos-multiforte-scaled.webp" imageAlt="" />
  </main>
  <Footer />
</BaseLayout>
