---
import data from '../data/wordpress.json';
---
<section id="avaliacoes" class="container-site py-16 md:py-24">
  <h2 class="mb-10 text-3xl font-semibold tracking-tight md:text-5xl">{data.clientsTitle}</h2>
  <div class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-zinc-200 bg-zinc-200 sm:grid-cols-3 lg:grid-cols-5">
    {data.logos.map(logo => <div class="flex min-h-36 items-center justify-center bg-white p-8"><img src={logo.image} alt={logo.name} loading="lazy" decoding="async" class="max-h-20 w-full object-contain" /></div>)}
  </div>
</section>
<section hidden={data.reviews.hidden} class="container-site pb-24">
  <h2 class="mb-10 text-3xl font-semibold">{data.reviews.title}</h2>
  <div class="grid gap-6 md:grid-cols-3">{data.reviews.items.map(review => <figure class="rounded-2xl bg-white p-8"><blockquote class="leading-relaxed" set:html={review.html} /><figcaption class="mt-6"><strong>{review.name}</strong><span class="mt-1 block text-sm text-zinc-500">{review.job}</span></figcaption></figure>)}</div>
</section>
