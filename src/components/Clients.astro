---
import data from '../data/wordpress.json';
const count = data.logos.length;
const position = (index: number) => {
  const offset = index > count / 2 ? index - count : index;
  return Math.abs(offset) <= 2 ? String(offset) : 'hidden';
};
---
<section id="clientes" class="clients-section py-16 md:py-24" aria-labelledby="clients-title" data-clients>
  <div class="container-site">
    <div class="mb-8 md:mb-10">
      <p class="eyebrow">{data.clientsTitle.toLocaleUpperCase('pt-BR')}</p>
      <h2 id="clients-title" class="section-title">Quem confia na nossa proteção</h2>
    </div>
    <div class="client-carousel" role="region" aria-label="Clientes atendidos" aria-roledescription="carrossel">
      <div id="clients-track" class="clients-track" tabindex="0" aria-label="Use as setas do teclado ou deslize para conhecer os clientes">
        {data.logos.map((logo, index) => <div class="client-slide" data-position={position(index)} role="group" aria-roledescription="slide" aria-label={`${index + 1} de ${count}`} aria-hidden={index !== 0}>
          <div class="client-logo-panel"><img src={logo.image} alt={logo.name || `Logo do cliente ${index + 1}`} width="300" height="190" loading="lazy" decoding="async" draggable="false" /></div>
        </div>)}
      </div>
      <div class="carousel-controls">
        <p class="carousel-position" aria-hidden="true"><span data-current>01</span><span class="carousel-total"> / {String(count).padStart(2, '0')}</span></p>
        <div class="carousel-buttons" role="group" aria-label="Controles do carrossel de clientes">
          <button type="button" data-prev class="client-arrow" aria-label="Cliente anterior" aria-controls="clients-track"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg></button>
          <button type="button" data-next class="client-arrow" aria-label="Próximo cliente" aria-controls="clients-track"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg></button>
        </div>
      </div>
      <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-client-announcement></p>
    </div>
  </div>
</section>
<style>
  .clients-section { position:relative; overflow:hidden; background:#0e1117; color:#fff; }
  .clients-section::before { content:''; position:absolute; inset:0; pointer-events:none; background:radial-gradient(ellipse at 50% 60%,rgb(227 6 19 / 13%),transparent 65%); }
  .clients-section > div { position:relative; }
  .clients-section .section-title { color:#fff; }
  .clients-section .eyebrow { color:#ff4a54; }
  .clients-track { position:relative; height:clamp(270px,65vw,400px); perspective:1100px; touch-action:pan-y pinch-zoom; outline-offset:-4px; }
  .client-slide { position:absolute; top:50%; left:50%; width:min(64%,350px); height:78%; padding:16px; border:1px solid rgb(255 255 255 / 65%); border-radius:24px; background:rgb(255 255 255 / 90%); backdrop-filter:blur(28px); box-shadow:inset 0 1px 0 rgb(255 255 255 / 19%),0 0 28px rgb(227 6 19 / 10%),0 20px 40px rgb(0 0 0 / 30%); transform:translate(-50%,-50%); transition:transform 1000ms cubic-bezier(.22,.68,.25,1),opacity 700ms,border-color 700ms; backface-visibility:hidden; pointer-events:none; }
  .client-logo-panel { width:100%; height:100%; display:grid; place-items:center; border-radius:15px; padding:18px; background:#fff; }
  .client-slide img { width:100%; height:100%; max-height:190px; object-fit:contain; user-select:none; }
  .client-slide[data-position="0"] { z-index:5; opacity:1; border-color:rgb(255 71 81 / 65%); box-shadow:inset 0 1px 0 rgb(255 255 255 / 24%),0 0 32px rgb(227 6 19 / 19%),0 20px 40px rgb(0 0 0 / 30%); }
  .client-slide[data-position="-1"] { z-index:3; opacity:1; transform:translate(-108%,-50%) rotateY(32deg) scale(.82); }
  .client-slide[data-position="1"] { z-index:3; opacity:1; transform:translate(8%,-50%) rotateY(-32deg) scale(.82); }
  .client-slide[data-position="-2"] { z-index:1; opacity:1; transform:translate(-151%,-50%) rotateY(40deg) scale(.64); }
  .client-slide[data-position="2"] { z-index:1; opacity:1; transform:translate(51%,-50%) rotateY(-40deg) scale(.64); }
  .client-slide[data-position="hidden"] { visibility:hidden; opacity:0; transform:translate(-50%,-50%) scale(.5); }
  .carousel-controls,.carousel-buttons { display:flex; align-items:center; justify-content:space-between; gap:12px; }
  .carousel-controls { position:relative; z-index:6; max-width:350px; margin:20px auto 0; }
  .carousel-position { font-size:.9375rem; font-weight:500; font-variant-numeric:tabular-nums; }
  .carousel-total { color:#aeb4c0; font-weight:400; }
  .client-arrow { width:48px; height:48px; display:grid; place-items:center; border:1px solid rgb(255 255 255 / 23%); border-radius:var(--radius-control); background:rgb(255 255 255 / 6%); color:#fff; transition:background .2s,border-color .2s; }
  .client-arrow:hover { background:#e30613; border-color:#e30613; }
  @media(max-width:639px) { .client-slide { padding:12px; border-radius:20px; } .client-logo-panel { padding:12px; border-radius:12px; } }
  @media(prefers-reduced-motion:reduce) { .client-slide { transition:none; } }
  @media(prefers-reduced-transparency:reduce) { .client-slide { background:#fff; backdrop-filter:none; } }
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-clients]');
  if (root) {
    const track = root.querySelector<HTMLElement>('.clients-track')!;
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.client-slide'));
    const current = root.querySelector<HTMLElement>('[data-current]')!;
    const announcement = root.querySelector<HTMLElement>('[data-client-announcement]')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const count = slides.length;
    let index = 0;
    let hovered = false;
    let focused = false;
    let inView = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let touch: { x: number; y: number } | null = null;
    function schedule() {
      clearTimeout(timer);
      if (count > 1 && inView && !reduced.matches && !hovered && !focused && !touch && !document.hidden) {
        timer = setTimeout(() => move(1), 6500);
      }
    }
    function move(step: number, manual = false) {
      if (!count) return;
      index = (index + step + count) % count;
      slides.forEach((slide, n) => {
        let offset = (n - index + count) % count;
        if (offset > count / 2) offset -= count;
        slide.dataset.position = Math.abs(offset) <= 2 ? String(offset) : 'hidden';
        slide.setAttribute('aria-hidden', String(n !== index));
      });
      current.textContent = String(index + 1).padStart(2, '0');
      if (manual) announcement.textContent = `${slides[index].querySelector('img')?.alt}, ${index + 1} de ${count}`;
      schedule();
    }
    root.querySelector('[data-prev]')!.addEventListener('click', () => move(-1, true));
    root.querySelector('[data-next]')!.addEventListener('click', () => move(1, true));
    track.addEventListener('keydown', event => {
      if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
        event.preventDefault();
        move(event.key === 'ArrowRight' ? 1 : -1, true);
      }
    });
    root.addEventListener('mouseenter', () => { hovered = true; schedule(); });
    root.addEventListener('mouseleave', () => { hovered = false; schedule(); });
    root.addEventListener('focusin', () => { focused = true; schedule(); });
    root.addEventListener('focusout', event => { focused = root.contains(event.relatedTarget as Node | null); schedule(); });
    track.addEventListener('touchstart', event => {
      const point = event.touches[0];
      touch = { x:point.clientX, y:point.clientY };
      schedule();
    }, { passive:true });
    track.addEventListener('touchend', event => {
      if (!touch) return;
      const point = event.changedTouches[0];
      const dx = point.clientX - touch.x;
      const dy = point.clientY - touch.y;
      touch = null;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.3) move(dx < 0 ? 1 : -1, true);
      else schedule();
    }, { passive:true });
    track.addEventListener('touchcancel', () => { touch = null; schedule(); }, { passive:true });
    document.addEventListener('visibilitychange', schedule);
    reduced.addEventListener('change', schedule);
    new IntersectionObserver(entries => { inView = entries[0].isIntersecting; schedule(); }, { threshold:.2 }).observe(track);
    schedule();
  }
</script>
