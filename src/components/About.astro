---
import data from '../data/wordpress.json';
const about = data.about;
---
<section id="quem-somos" class="bg-white py-16 md:py-24">
  <div class="container-site grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
    <div class="relative"><img src={about.image} alt="" width="2560" height="1707" loading="lazy" decoding="async" class="aspect-[4/5] w-full rounded-2xl object-cover" /><div aria-hidden="true" class="absolute -bottom-3 right-6 h-3 w-24 bg-brand"></div></div>
    <div><p class="mb-5 type-section text-brand">{about.eyebrow}</p>
      <h2 class="type-lead">{about.title}</h2>
      <div class="prose-site mt-7" set:html={about.html} />
      <dl class="mt-10 grid grid-cols-2 gap-6 border-t border-zinc-200 pt-8">{about.counters.map(counter => <div><dd class="type-stat text-brand">{counter.number}</dd><dt class="mt-2 type-stat-label text-zinc-600">{counter.label}</dt></div>)}</dl>
    </div>
  </div>
</section>
