---
import data from '../data/wordpress.json';
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
---
<section class:list={['py-10 md:py-14', dark ? 'bg-brand text-white' : 'border-b border-zinc-200 bg-white']}>
  <div class="container-site flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
    <h2 class="max-w-2xl type-cta">{data.cta.title}</h2>
    <a href={data.cta.href} class:list={['button shrink-0', dark && 'bg-white! text-ink! hover:bg-zinc-200!']}>{data.cta.label}<span aria-hidden="true" class="ml-6">↗</span></a>
  </div>
</section>
