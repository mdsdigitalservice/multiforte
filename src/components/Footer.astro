6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077\"/></svg>","facebook":"<svg aria-hidden=\"true\" focusable=\"false\" role=\"img\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><title>Facebook</title><path d=\"M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z\"/></svg>","youtube":"<svg aria-hidden=\"true\" focusable=\"false\" role=\"img\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><title>YouTube</title><path d=\"M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z\"/></svg>"};
const socials = data.footer.socials.filter(social => social.label !== 'Localização');
---
<footer id="rodape" class="site-footer">
  <div class="footer-invitation">
    <div class="container-site footer-invitation-inner">
      <h2>{data.cta.title}</h2>
      <a href={data.footer.cta.href} class="button footer-proposal">
        <svg aria-hidden="true" focusable="false" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><title>WhatsApp</title><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
        {data.footer.cta.label}
      </a>
    </div>
  </div>
  <div class="footer-contacts">
    <div class="container-site footer-contacts-inner">
      <a class="footer-location" href={location?.href} aria-label={`Ver localização no mapa: ${data.footer.address}`}>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a8 8 0 0 0-8 8c0 6 8 12 8 12s8-6 8-12a8 8 0 0 0-8-8Zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"/></svg>
        <span class="footer-location-text">{data.footer.address}</span>
      </a>
      <div class="footer-phones">
        <a href="tel:+556530544456" class="footer-phone" aria-label={`Ligar para ${data.footer.phones[0]}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.91.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.58 2.81.7A2 2 0 0 1 22 16.92Z"/></svg><span class="footer-phone-text">{data.footer.phones[0]}</span></a>
        <a href={data.footer.cta.href} class="footer-whatsapp" aria-label={`Falar pelo WhatsApp: ${data.footer.phones[1]}`}>
          <svg aria-hidden="true" focusable="false" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><title>WhatsApp</title><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          <span class="footer-whatsapp-text">{data.footer.phones[1]}</span>
        </a>
      </div>
      <nav class="footer-socials" aria-label="Redes sociais">{socials.map(social => <a href={social.href} aria-label={social.label} title={social.label} data-social={social.label.toLowerCase()}><span set:html={socialIcons[social.label.toLowerCase()]} /></a>)}</nav>
    </div>
  </div>
  <div class="container-site footer-bottom">
    <nav class="footer-legal" aria-label="Rodapé">{data.footer.links.map(link => <a href={link.href}><span aria-hidden="true">✓</span>{link.label}</a>)}</nav>
    <div class="footer-copyright" set:html={data.footer.copyrightDesktop} />
    <a href="/#home" class="footer-top" aria-label="Voltar ao início"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 15 7-7 7 7"/></svg></a>
  </div>
</footer>
<style>
  .site-footer { background:white; color:#5c5c5c; }
  .site-footer a { color:inherit; text-decoration:none; }
  .site-footer a:hover { color:#E30613; }
  .footer-invitation { background:#090909; color:white; padding-block:64px; }
  .footer-invitation-inner { display:flex; justify-content:center; align-items:center; gap:24px; }
  .footer-invitation h2 { font-family:"Montserrat",Arial,sans-serif; font-size:clamp(1.4rem,2.4vw,2rem); font-weight:700; text-transform:uppercase; line-height:1.3; letter-spacing:-.025em; margin:0; }
  .footer-proposal { flex-shrink:0; gap:8px; text-transform:uppercase; color:white!important; font-size:.85rem; }
  .footer-proposal svg { width:22px; height:22px; }
  .footer-contacts { background:radial-gradient(ellipse at 50% 100%,#e4e4e4 0%,#f6f6f6 45%,#fff 76%); }
  .footer-contacts-inner { display:grid; grid-template-columns:1fr auto; align-items:center; gap:20px 32px; padding-top:44px; padding-bottom:28px; }
  .footer-location { display:flex; align-items:center; gap:12px; font-size:.85rem; font-weight:600; line-height:1.6; }
  .footer-location svg { flex-shrink:0; width:26px; height:30px; }
  .footer-phones { display:flex; flex-wrap:wrap; justify-content:flex-end; align-items:center; gap:20px; font-weight:600; font-size:1rem; }
  .footer-phone svg { display:none; width:26px; height:26px; }
  .footer-whatsapp { display:inline-flex; align-items:center; gap:10px; }
  .footer-whatsapp svg { width:26px; height:26px; }
  .footer-socials { grid-column:1/-1; display:flex; justify-content:center; flex-wrap:wrap; gap:20px; font-size:.75rem; }
  .footer-socials a { display:flex; align-items:center; justify-content:center; width:36px; height:44px; border-radius:8px; }
  .footer-socials a { color:#5c5c5c; }
  .footer-socials a:hover { color:#5c5c5c; background:#ffffff80; }
  .footer-socials :global(svg) { display:block; width:23px; height:23px; fill:currentColor; }
  .footer-bottom { display:grid; grid-template-columns:auto 1fr 44px; align-items:center; gap:24px; padding-block:24px; font-size:.8rem; line-height:1.6; }
  .footer-legal { display:flex; flex-direction:row; flex-wrap:wrap; align-items:center; gap:8px 20px; }
  .footer-legal a { display:flex; gap:8px; align-items:center; white-space:nowrap; }
  .footer-copyright { text-align:center; }
  .footer-copyright :global(p) { margin:0; }
  .footer-copyright :global(a) { color:inherit; text-decoration:none; }
  .footer-copyright :global(a:hover) { color:#E30613; }
  .footer-top { display:flex; width:44px; height:44px; align-items:center; justify-content:center; border-radius:50%; }
  .footer-top:hover { background:#f4f4f4; }
  .footer-top svg { width:22px; height:22px; }
  @media(min-width:1024px) {
    .footer-contacts-inner { grid-template-columns:minmax(0,1fr) auto auto; gap:24px; padding-block:36px; }
    .footer-socials { grid-column:auto; flex-wrap:nowrap; gap:8px; }
    .footer-phones { flex-wrap:nowrap; gap:16px; font-size:.95rem; }
    .footer-phones a { white-space:nowrap; }
    .footer-legal { flex-wrap:nowrap; }
    .footer-copyright { white-space:nowrap; }
  }
  @media(max-width:767px) {
    .footer-invitation { padding-block:40px; }
    .footer-invitation-inner { flex-direction:column; gap:20px; text-align:center; }
    .footer-contacts-inner { grid-template-columns:44px auto; justify-content:center; padding-block:28px; gap:16px; }
    .footer-location { justify-content:center; min-width:44px; min-height:44px; }
    .footer-location-text,.footer-whatsapp-text,.footer-phone-text { display:none; }
    .footer-phone { display:inline-flex; justify-content:center; align-items:center; min-width:44px; min-height:44px; }
    .footer-phone svg { display:block; }
    .footer-phones { justify-content:center; flex-wrap:nowrap; gap:16px; font-size:.9rem; }
    .footer-phones > a { white-space:nowrap; }
    .footer-whatsapp { justify-content:center; min-width:44px; min-height:44px; }
    .footer-socials { gap:24px; }
    .footer-bottom { position:relative; display:flex; flex-direction:column; gap:12px; padding-block:20px 24px; }
    .footer-legal { width:100%; justify-content:center; flex-wrap:nowrap; gap:16px; font-size:clamp(.625rem,2.8vw,.75rem); }
    .footer-legal a { min-height:44px; }
    .footer-legal a span { display:none; }
    .footer-copyright { width:100%; padding-inline:28px; text-align:center; font-size:.75rem; line-height:1.7; }
    .footer-copyright :global(a) { display:block; width:fit-content; margin:8px auto 0; min-height:24px; font-weight:600; }
    .footer-top { position:absolute; right:8px; bottom:18px; }

  }
</style>
