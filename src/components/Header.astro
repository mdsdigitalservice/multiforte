---
import { site, type NavLink } from '../data/site';
import data from '../data/wordpress.json';
interface Props { links: NavLink[] }
const { links } = Astro.props;
---
<header class="site-header">
  <div class="header-bar">
    <a href="/" aria-label={site.name} class="header-logo"><img src={site.logo} width="300" height="72" alt={site.name} decoding="async" /></a>
    <nav class="desktop-navigation" aria-label="Principal desktop">
      {links.map(link => <a href={link.href}>{link.label}</a>)}
      <a href={data.footer.cta.href} class="button header-contact">{data.footer.cta.label}<span aria-hidden="true">↗</span></a>
    </nav>
    <details class="header-menu">
      <summary aria-label="Abrir menu de navegação" aria-controls="header-navigation" aria-expanded="false">
        <span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span>
      </summary>
      <nav id="header-navigation" aria-label="Principal">
        {links.map(link => <a href={link.href}>{link.label}</a>)}
        <a href={data.footer.cta.href} class="button header-contact">{data.footer.cta.label}<span aria-hidden="true">↗</span></a>
      </nav>
    </details>
  </div>
</header>
<div class="site-header-space" aria-hidden="true"></div>
<style>
  .site-header { position:fixed; inset:0 0 auto; z-index:50; color:white; background:rgba(5,5,5,.86); -webkit-backdrop-filter:blur(20px) saturate(140%); backdrop-filter:blur(20px) saturate(140%); }
  .header-bar { width:100%; max-width:1280px; height:clamp(80px,20vw,112px); margin-inline:auto; padding-inline:clamp(12px,2.5vw,32px); display:flex; align-items:center; justify-content:space-between; gap:24px; }
  .header-logo { display:block; width:clamp(210px,57vw,340px); max-width:calc(100% - 74px); flex-shrink:0; }
  .header-logo img { display:block; width:100%; height:auto; }
  summary { display:flex; align-items:center; justify-content:center; width:52px; height:52px; list-style:none; border:0; border-radius:8px; color:white; }
  summary::-webkit-details-marker { display:none; }
  summary::marker { content:""; }
  summary:hover { background:rgba(255,255,255,.08); }
  .menu-icon { display:flex; width:26px; flex-direction:column; gap:5px; }
  .menu-icon span { display:block; width:100%; height:3px; border-radius:4px; background:currentColor; transition:transform .2s,opacity .2s; }
  details[open] .menu-icon span:nth-child(1) { transform:translateY(8px) rotate(45deg); }
  details[open] .menu-icon span:nth-child(2) { opacity:0; }
  details[open] .menu-icon span:nth-child(3) { transform:translateY(-8px) rotate(-45deg); }
  nav { position:absolute; inset:100% 0 auto; display:flex; flex-direction:column; gap:4px; max-height:calc(100dvh - clamp(80px,20vw,112px)); overflow-y:auto; padding:16px max(24px,calc((100vw - 1216px)/2)) 28px; background:rgba(5,5,5,.94); -webkit-backdrop-filter:blur(20px); backdrop-filter:blur(20px); border-top:1px solid rgba(255,255,255,.12); }
  nav a:not(.button) { padding:14px 12px; border-radius:8px; font-family:"Montserrat",Arial,sans-serif; font-size:1rem; font-weight:600; color:white; text-decoration:none; }
  nav a:not(.button):hover { background:rgba(255,255,255,.08); }
  .header-contact { align-self:flex-start; gap:16px; margin-top:12px; }
  .site-header-space { height:clamp(80px,20vw,112px); }
  .desktop-navigation { display:none; }
  @media(min-width:1024px) {
    .header-logo { width:240px; }
    .header-menu { display:none; }
    .desktop-navigation { position:static; inset:auto; display:flex; flex-direction:row; align-items:center; gap:6px; max-height:none; overflow:visible; padding:0; background:transparent; border:0; -webkit-backdrop-filter:none; backdrop-filter:none; }
    .desktop-navigation a { white-space:nowrap; }
    .desktop-navigation a:not(.button) { padding:12px 10px; font-size:.85rem; }
    .desktop-navigation .header-contact { align-self:auto; margin:0 0 0 12px; gap:12px; font-size:.75rem; }
  }
  :global(html) { scroll-padding-top:calc(clamp(80px,20vw,112px) + 16px); }
</style>
<script>
  document.querySelectorAll<HTMLDetailsElement>('.header-menu').forEach(menu => {
    const summary = menu.querySelector('summary')!;
    const sync = () => {
      summary.setAttribute('aria-expanded', String(menu.open));
      summary.setAttribute('aria-label', menu.open ? 'Fechar menu de navegação' : 'Abrir menu de navegação');
    };
    menu.addEventListener('toggle', sync);
    menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; sync(); }));
    menu.addEventListener('keydown', event => {
      if (event.key === 'Escape') { menu.open = false; sync(); summary.focus(); }
    });
    document.addEventListener('click', event => {
      if (menu.open && !menu.contains(event.target as Node)) { menu.open = false; sync(); }
    });
    document.addEventListener('focusin', event => {
      if (menu.open && !menu.contains(event.target as Node)) { menu.open = false; sync(); }
    });
  });
</script>
