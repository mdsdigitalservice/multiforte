---
import data from '../data/wordpress.json';
---
<section id="contato" class="container-site py-16 md:py-24"><div class="grid items-center gap-10 rounded-[32px] bg-zinc-50 p-6 text-ink sm:p-10 lg:grid-cols-2 lg:p-16">
 <div><p class="eyebrow">Fale com a Multiforte</p><h2 class="section-title">Vamos proteger seu patrimônio?</h2><p class="mt-6 text-zinc-600">Conte o que sua empresa ou condomínio precisa. Nossa equipe vai ajudar você a encontrar a melhor solução.</p><p class="mt-7 text-sm text-zinc-600">{data.footer.address}</p><a href="tel:+556530544456" class="mt-3 inline-block text-lg font-bold">(65) 3054-4456</a><a href={data.footer.cta.href} class="mt-2 block text-sm underline underline-offset-4">Falar pelo WhatsApp: (65) 98402-7828</a></div>
 <form id="proposal-form" action="https://wa.me/5565984027828" method="get" class="space-y-4 rounded-[20px] bg-white p-6 text-ink sm:p-8">
  <label class="block text-sm font-medium" for="contact-name">Seu nome<input id="contact-name" name="nome" autocomplete="name" required maxlength="120" class="mt-2 block min-h-12 w-full rounded-full border border-zinc-200 px-5 py-3" /></label>
  <label class="block text-sm font-medium" for="contact-company">Empresa ou condomínio<input id="contact-company" name="empresa" autocomplete="organization" required maxlength="160" class="mt-2 block min-h-12 w-full rounded-full border border-zinc-200 px-5 py-3" /></label>
  <label class="block text-sm font-medium" for="contact-phone">Seu WhatsApp<input id="contact-phone" name="telefone" type="tel" autocomplete="tel" required maxlength="30" class="mt-2 block min-h-12 w-full rounded-full border border-zinc-200 px-5 py-3" /></label>
  <button type="submit" class="button w-full">Solicitar orçamento pelo WhatsApp</button><p class="text-center text-xs leading-relaxed text-zinc-500">Os dados serão incluídos na mensagem para você enviar pelo WhatsApp. <a href="/politica-de-privacidade/" class="underline">Política de privacidade</a>.</p>
 </form>
</div></section>
<script>
 const form = document.querySelector<HTMLFormElement>('#proposal-form');
 form?.addEventListener('submit', event => {
  event.preventDefault(); if (!form.reportValidity()) return;
  const values = new FormData(form);
  const message = `Olá! Vim do site da Multiforte e gostaria de solicitar um orçamento.\nNome: ${values.get('nome')}\nEmpresa/Condomínio: ${values.get('empresa')}\nWhatsApp: ${values.get('telefone')}`;
  const destination = `https://wa.me/5565984027828?text=${encodeURIComponent(message)}`;
  // This measures a validated request to open WhatsApp, not a message sent or a sale.
  // Never put the form values or the destination URL (which contains them) in analytics.
  let opened = false;
  const openWhatsApp = () => {
   if (opened) return;
   opened = true;
   window.location.assign(destination);
  };
  const analyticsWindow = window as Window & { dataLayer?: Record<string, unknown>[] };
  const consent = (window as Window & { mfConsent?: { allowsAnalytics(): boolean } }).mfConsent;
  if (!consent?.allowsAnalytics()) { openWhatsApp(); return; }
  analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
  window.setTimeout(openWhatsApp, 800);
  analyticsWindow.dataLayer.push({
   event: 'mf_whatsapp_form',
   contact_method: 'whatsapp',
   form_id: 'proposal-form',
   eventCallback: openWhatsApp,
   eventTimeout: 700,
  });
 });
</script>
