---
import data from '../data/wordpress.json';
---
<section class="bg-ink py-16 text-white md:py-24"><div class="container-site grid items-center gap-12 lg:grid-cols-2">
  <div><h2 class="type-lead" set:html={data.secondary.title} /><div class="mt-8 type-body text-zinc-300" set:html={data.secondary.html} /></div>
  <div class="overflow-hidden rounded-2xl border border-white/10 bg-black">
    <iframe src="https://www.youtube-nocookie.com/embed/R1MOzNQ1OKI" title="Vídeo institucional — Multiforte Segurança" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen class="aspect-video w-full border-0"></iframe>
  </div>
</div></section>
