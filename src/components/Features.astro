---
interface Props { title: string; items: { title: string; text: string }[]; id?: string }
const { title, items, id } = Astro.props;
---
<section id={id} class="container-site py-16 md:py-24">
  <h2 class="max-w-3xl text-3xl font-semibold tracking-tight md:text-5xl">{title}</h2>
  <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {items.map(item => <article class="rounded-2xl border border-zinc-200 bg-white p-7 md:p-9">
      <div class="mb-7 h-1 w-10 bg-brand"></div><h3 class="text-xl font-semibold">{item.title}</h3>
      <p class="mt-4 leading-relaxed text-zinc-600">{item.text}</p>
    </article>)}
  </div>
</section>
