---
import data from '../data/wordpress.json';
---
<section id="portfolio" class="bg-white py-16 md:py-24">
 <div class="container-site grid items-center gap-x-10 gap-y-6 md:grid-cols-2 md:gap-y-9 lg:gap-x-20">
  <div class="text-center md:col-start-2 md:row-start-1 md:self-end md:text-left">
   <p class="eyebrow">Portfólio</p>
   <h2 class="section-title">{data.portfolio.subtitle}</h2>
  </div>
  <a href={data.portfolio.cta.href} aria-label="Abrir catálogo da Multiforte" class="md:col-start-1 md:row-start-1 md:row-span-2">
   <img src={data.portfolio.image} width="696" height="501" alt="Catálogo institucional da Multiforte Segurança" loading="lazy" decoding="async" class="w-full" />
  </a>
  <div class="text-center md:col-start-2 md:row-start-2 md:self-start md:text-left">
   <a href={data.portfolio.cta.href} class="button button-navy"><span aria-hidden="true" class="mr-3 text-xl">»</span>{data.portfolio.cta.label}</a>
   <p class="mt-4 text-xs text-zinc-500">Apresentação institucional em PDF</p>
  </div>
 </div>
</section>
