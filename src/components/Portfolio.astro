---
import data from '../data/wordpress.json';
---
<section id="portfolio" class="bg-white py-16 md:py-24"><div class="container-site grid items-center gap-10 md:grid-cols-2 lg:gap-20">
 <a href={data.portfolio.cta.href} aria-label="Abrir catálogo da Multiforte" class="order-2 md:order-1"><img src={data.portfolio.image} width="696" height="501" alt="Catálogo institucional da Multiforte Segurança" loading="lazy" decoding="async" class="w-full" /></a>
 <div class="order-1 text-center md:order-2 md:text-left"><h2 class="type-portfolio text-brand">PORTFÓLIO</h2><p class="mt-5 text-xl font-medium text-zinc-800">{data.portfolio.subtitle}</p><a href={data.portfolio.cta.href} class="button button-navy mt-9"><span aria-hidden="true" class="mr-3 text-xl">»</span>{data.portfolio.cta.label}</a><p class="mt-4 text-xs text-zinc-500">Apresentação institucional em PDF</p></div>
</div></section>
