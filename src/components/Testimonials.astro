---
import data from '../data/wordpress.json';
---
<section id="avaliacoes" class="bg-zinc-50 py-16 md:py-20"><div class="container-site"><p class="eyebrow">Depoimentos</p><h2 class="section-title">O que dizem nossos clientes</h2><div class="mt-10 grid gap-6 md:grid-cols-3">{data.reviews.items.map(r => <figure class="rounded-[20px] border border-zinc-200 bg-white p-7"><blockquote class="text-sm leading-relaxed text-zinc-600" set:html={r.html} /><figcaption class="mt-6"><strong class="block text-sm">{r.name}</strong><span class="mt-1 block text-xs text-zinc-500">{r.job}</span></figcaption></figure>)}</div></div></section>
