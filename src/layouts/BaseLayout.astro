---
import '../styles/global.css';
import { site } from '../data/site';
import CookieConsent from '../components/CookieConsent.astro';
import SiteMotion from '../components/SiteMotion.astro';
import consentBootstrap from '../scripts/consent-bootstrap.js?raw';
interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  noindex?: boolean;
  preloadImage?: string;
  mobilePreloadImage?: string;
}
const { title, description = site.description, canonicalPath, image, noindex = false, preloadImage, mobilePreloadImage } = Astro.props;
const canonical = canonicalPath ? new URL(canonicalPath, site.origin).href : undefined;
const socialImage = image ? new URL(image, site.origin).href : undefined;
// Business data describes the services and contacts visible on the home page.
const businessSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": "https://www.multiforteseguranca.com.br/#empresa",
      "name": "Multiforte Segurança",
      "url": "https://www.multiforteseguranca.com.br/",
      "description": "Empresa de segurança patrimonial, controle de acesso e facilities em Cuiabá, Mato Grosso.",
      "image": socialImage,
      "telephone": "+556530544456",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Rua das Rosas, 350, Jardim Cuiabá",
        "addressLocality": "Cuiabá",
        "addressRegion": "MT",
        "postalCode": "78043-128",
        "addressCountry": "BR"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "Orçamentos pelo WhatsApp",
        "telephone": "+5565984027828",
        "url": "https://wa.me/5565984027828",
        "availableLanguage": "pt-BR"
      },
      "sameAs": [
        "https://www.instagram.com/multiforteseguranca/",
        "https://www.facebook.com/multiforteseguranca"
      ],
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Serviços da Multiforte Segurança",
        "itemListElement": [
          {
            "@type": "Offer",
            "itemOffered": {
              "@id": "https://www.multiforteseguranca.com.br/#seguranca-patrimonial"
            }
          },
          {
            "@type": "Offer",
            "itemOffered": {
              "@id": "https://www.multiforteseguranca.com.br/#agente-portaria"
            }
          }
        ]
      }
    },
    {
      "@type": "Service",
      "@id": "https://www.multiforteseguranca.com.br/#seguranca-patrimonial",
      "name": "Segurança patrimonial",
      "serviceType": "Segurança patrimonial",
      "provider": {
        "@id": "https://www.multiforteseguranca.com.br/#empresa"
      }
    },
    {
      "@type": "Service",
      "@id": "https://www.multiforteseguranca.com.br/#agente-portaria",
      "name": "Agente de portaria",
      "serviceType": "Portaria e controle de acesso",
      "provider": {
        "@id": "https://www.multiforteseguranca.com.br/#empresa"
      }
    }
  ]
};

---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {canonicalPath === '/' && !noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(businessSchema).replace(/</g, '\\u003c')} />}
    <!-- Consent defaults run before GTM. Optional tags load only after a choice. -->
    <script is:inline set:html={consentBootstrap} />
    {mobilePreloadImage && !mobilePreloadImage.startsWith("data:") && <link rel="preload" href={mobilePreloadImage} media="(max-width: 480px)" as="image" type="image/avif" fetchpriority="high" />}
    {preloadImage && <link rel="preload" href={preloadImage} media={mobilePreloadImage ? "(min-width: 481px)" : undefined} as="image" type="image/avif" fetchpriority="high" />}
    <link rel="preload" href="/fonts/optimized/inter-400.ca6c397b35.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/optimized/montserrat-900.d749da53fa.woff2" as="font" type="font/woff2" crossorigin />

    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
  </head>
  <body>
    <a href="#conteudo" class="sr-only fixed left-4 top-4 z-50 rounded bg-white p-4 focus:not-sr-only">Pular para o conteúdo</a>
    <slot />
    <CookieConsent />
    <SiteMotion />
    <script is:inline>
      document.addEventListener('click', function(event) {
        var link = event.target instanceof Element ? event.target.closest('a[href]') : null;
        if (link && link.getAttribute('href') === 'tel:+556530544456' && window.mfConsent?.allowsAnalytics()) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'mf_phone_click', contact_method: 'phone' });
        }
      }, true);
    </script>
  </body>
</html>
